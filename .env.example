# Copy this file to .env and fill it in. Never commit .env.

# ---- Database (PostgreSQL) ----
# On your computer, `npm run dev` starts a local database and these two lines work as they are.
# Online (Neon, Supabase, Vercel Postgres...): DATABASE_URL is the "pooled" connection string and
# DIRECT_URL is the "direct" one. See DEPLOY.md.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=1&pgbouncer=true"
DIRECT_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=1"

# ---- Login ----
# The address people use to open the app. Passport QR codes and share links are built from it,
# so change it to your real https:// address before printing cards or sending links.
NEXTAUTH_URL="http://localhost:3000"
# A long random secret. Make one with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ---- Time ----
# Used until a visitor's own timezone is known. Optional: the default is Africa/Lagos.
# DEFAULT_TIMEZONE="Africa/Lagos"

# ---- Photo storage ----
# Leave S3_BUCKET empty on your computer: photos are kept in the ./uploads folder.
# Online you MUST fill these in (Cloudflare R2, AWS S3, Supabase Storage...). See DEPLOY.md.
S3_BUCKET=""
S3_REGION=""             # "auto" for Cloudflare R2, or e.g. "eu-west-1" for AWS S3
S3_ENDPOINT=""           # R2/Supabase: your storage address. Leave empty for AWS S3.
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=""   # "true" only if your provider asks for it
