// PatientLog data model. PostgreSQL everywhere: on your computer (npm run db:start) and online.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // a direct (not pooled) connection, used by migrations
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  dateOfBirth  DateTime? @map("date_of_birth")
  bloodGroup   String?   @map("blood_group")
  genotype     String? // AA, AS, SS, AC or SC

  // Profile extras (all optional)
  emergencyContactName  String? @map("emergency_contact_name")
  emergencyContactPhone String? @map("emergency_contact_phone")

  createdAt DateTime @default(now()) @map("created_at")
  entries   Entry[]
  passport  Passport?
  shares    Share[]

  // Raising this signs the person out everywhere: a login only counts while it carries the current number.
  sessionVersion Int @default(0) @map("session_version")

  @@map("users")
}

model Entry {
  id     String   @id @default(cuid())
  userId String   @map("user_id")
  date   DateTime
  title  String
  body   String

  // Comma-separated tag names, e.g. "Diagnosis,Lab Result". The allowed values live in lib/tags.ts.
  tags String @default("")

  // Reserved for the future "share with clinician" feature. Not used by any UI yet.
  // A later EntryShare table (entry_id, clinician_id, expires_at) can build on this
  // without changing the Entry table.
  shared Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments  Attachment[]
  shareEntries ShareEntry[]

  @@index([userId, date])
  @@map("entries")
}

// A supporting image (photo of a lab result, prescription, ...) attached to an entry.
// The file itself lives on disk (see lib/storage.ts); only its details are stored here.
model Attachment {
  id        String   @id @default(cuid())
  entryId   String   @map("entry_id")
  fileName  String   @map("file_name") // original name, for display
  mimeType  String   @map("mime_type")
  sizeBytes Int      @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at")

  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@map("attachments")
}

// The details on the patient's emergency health passport (the card with a QR code).
// Name, date of birth, blood group, genotype and emergency contact come from User, so they are stored once.
model Passport {
  id                 String   @id @default(cuid()) // printed on the card and inside the QR code
  userId             String   @unique @map("user_id")
  sex                String // "male" | "female" | "other"
  allergies          String?
  chronicConditions  String?  @map("chronic_conditions")
  currentMedications String?  @map("current_medications")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("passports")
}

// A link the patient creates to show chosen entries to a clinician, who needs no account.
// The link's secret is shown once when it is created. Only its SHA-256 fingerprint is stored here.
model Share {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  label        String? // e.g. "Dr Bello, General Hospital"
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at") // set when the patient turns the link off
  viewCount    Int       @default(0) @map("view_count")
  lastViewedAt DateTime? @map("last_viewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries ShareEntry[]

  @@index([userId])
  @@map("shares")
}

// Which entries a share shows.
model ShareEntry {
  shareId String @map("share_id")
  entryId String @map("entry_id")

  share Share @relation(fields: [shareId], references: [id], onDelete: Cascade)
  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@id([shareId, entryId])
  @@map("share_entries")
}
